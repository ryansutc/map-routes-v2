# Runtime profile: development or production.
# Production must set this to production to load settings/production.py.
ENVIRONMENT=development

# Required in production. Generate a long, random value and keep it secret.
# Development has an insecure fallback, but using a local value is recommended.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Recommended as a separate production secret for signing JWT access tokens.
# If omitted, Django falls back to DJANGO_SECRET_KEY.
JWT_SECRET=replace-with-a-different-long-random-secret

# Backend and frontend hosts.
# Development values:
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Production example (replace the three values above):
# ALLOWED_HOSTS=ryansutc.pythonanywhere.com
# CORS_ALLOWED_ORIGINS=https://map-routes-v2.ryansutc.workers.dev
# FRONTEND_URL=https://map-routes-v2.ryansutc.workers.dev

# Optional. Hostnames only (no scheme); needed only if social-auth may honor an
# external `next` redirect. The current OAuth callback uses FRONTEND_URL instead.
SOCIAL_AUTH_ALLOWED_REDIRECT_HOSTS=

# Required only for Google OAuth login. The Google OAuth client must also allow
# the backend's callback URL, for example:
# https://ryansutc.pythonanywhere.com/social/complete/google-oauth2/
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Required for GPX uploads to ArcGIS Online.
ARCGIS_USERNAME=replace-with-arcgis-username
ARCGIS_PASSWORD=replace-with-arcgis-password

# Required for route photo upload and deletion.
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# The database is currently SQLite at django_backend/app.db. DATABASE_URL is
# intentionally absent because the Django settings do not read it.
# DEBUG is intentionally absent because settings/development.py and
# settings/production.py set it from ENVIRONMENT.
