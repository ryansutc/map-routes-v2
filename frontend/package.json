{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' pnpm exec tsc -b && NODE_OPTIONS='--max-old-space-size=8192' pnpm exec vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "schema-fetch": "curl -s 'http://localhost:8000/api/schema/?format=json' -o ./docs/schema.json",
    "schema-to-zod": "openapi-zod-client ./docs/schema.json --output ./src/generatedtypes/django_generated.ts --with-docs --with-description  -p ./.prettierrc && ./cleanup_django_generated.sh",
    "schema-zod-to-json": "tsx generate-schema-types.ts",
    "schema-json-to-ts": "json2ts -i ./docs/schema.json -o ./src/types/django_api_types.ts",
    "schema": "pnpm run schema-fetch && pnpm run schema-to-zod",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@arcgis/core": "^4.33.11",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.0.1",
    "@mui/material": "^7.3.11",
    "@redux-devtools/extension": "^4.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@zodios/core": "^10.9.6",
    "axios": "^1.18.1",
    "nanoid": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^19.1.1",
    "recharts": "^3.10.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-dom": "^5.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-zod-client": "^1.18.3",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
